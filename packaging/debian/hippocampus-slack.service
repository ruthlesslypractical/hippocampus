[Unit]
Description=Hippocampus Slack Channel Archival Bot
After=network.target redis-server.service valkey-server.service hippocampus-daemon.service
Wants=redis-server.service

[Service]
Type=simple
ExecStart=/usr/bin/hippocampus-slack
Environment=HIPPOCAMPUS_CONFIG=/etc/hippocampus/config.json
Restart=on-failure
RestartSec=10
Nice=12
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/hippocampus
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
